@page "/servicios/notebooks"

<PageTitle>Notebooks - Dexter Servicio Técnico</PageTitle>

<style>
    body {
        background-color: #000;
        color: #f8f9fa;
    }

    .whatsapp-float {
        position: fixed;
        width: 60px;
        height: 60px;
        bottom: 20px;
        right: 20px;
        background-color: #25d366;
        color: #FFF;
        border-radius: 50px;
        text-align: center;
        font-size: 30px;
        box-shadow: 2px 2px 10px rgba(0,0,0,0.5);
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none !important;
        transition: 0.3s;
    }

        .whatsapp-float:hover {
            transform: scale(1.1);
            color: #FFF;
        }
</style>

<div class="container mt-4 pb-5">
    <NavLink href="/" class="btn btn-outline-primary mb-4"><i class="bi bi-arrow-left"></i> Volver</NavLink>

    <div style="background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url('/img/net3.jpg'); background-size: cover; background-position: center; height: 250px; display: flex; align-items: center; justify-content: center; border-radius: 15px; border: 1px solid #333;">
        <h1 class="display-4 fw-bold text-white text-center">NOTEBOOKS</h1>
    </div>

    <div class="mt-5">
        <h3 class="text-primary border-bottom pb-2">Hardware y Software</h3>
        <div class="row g-3 mt-2">
            @for (int i = 1; i <= 8; i++)
            {
                <div class="col-md-3 col-6"><img src="/img/net@(i).jpg" class="img-fluid rounded border border-secondary" style="height:180px; width:100%; object-fit:cover;" /></div>
            }
        </div>
    </div>

    <hr class="border-secondary mt-5" />
    <div class="row g-4 mt-2">
        <div class="col-md-6">
            <div class="card h-100 p-4" style="background-color: #111; border: 1px solid #333;">
                <h4 class="fw-bold mb-4 text-white">Soporte Técnico</h4>
                <div class="d-grid gap-3">
                    <a href="https://whatsapp.com" target="_blank" class="btn btn-success btn-lg text-start"><i class="bi bi-whatsapp me-2"></i> WhatsApp Notebook</a>
                    <a href="https://facebook.com" target="_blank" class="btn btn-outline-primary btn-lg text-start"><i class="bi bi-facebook me-2"></i> Facebook</a>
                    <a href="https://instagram.com" target="_blank" class="btn btn-outline-danger btn-lg text-start"><i class="bi bi-instagram me-2"></i> Instagram</a>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100 shadow-sm overflow-hidden" style="background-color: #111; border: 1px solid #333;">
                <div class="ratio ratio-16x9">
                    <iframe src="@UrlMapaEmbed"
                            style="border:0;"
                            allowfullscreen=""
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade">
                    </iframe>
                </div>
                <div class="p-2">
                    <a href="@UrlComoLlegar" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm w-100">
                        <i class="bi bi-geo-alt-fill me-1"></i> Cómo llegar
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
<a href="https://whatsapp.com" class="whatsapp-float" target="_blank"><i class="bi bi-whatsapp"></i></a>

@code {
    private string DireccionLocal = "Alejandro Korn, Buenos Aires";

    private string UrlMapaEmbed => $"https://maps.google.com/maps?q={Uri.EscapeDataString(DireccionLocal)}&t=&z=15&ie=UTF8&iwloc=&output=embed";

    private string UrlComoLlegar => $"https://www.google.com/maps/dir/?api=1&destination={Uri.EscapeDataString(DireccionLocal)}";
}